---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Pic from '../../components/Pic.astro';
import { langPaths, type Lang } from '../../i18n';
import { PHOTOS } from '../../i18n/images';
import { descobrir } from '../../i18n/content/descobrir';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const c = descobrir[lang];
---
<Base lang={lang} pageKey="descobrirodouro" title={c.title} description={c.description}>
  <PageHead lang={lang} eyebrow={c.eyebrow} title={c.h1} intro={c.intro} photo={PHOTOS.valley} position="50% 60%" />

  <section class="section section--alt">
    <div class="container">
      <div class="center reveal"><h2 set:html={c.viewpoints.title} /><hr class="rule" /></div>
      <div class="grid-2" style="margin-top:2.5rem">
        {c.viewpoints.items.map((x) => (
          <article class="tile place reveal">
            <h3>{x.name}</h3>
            <p class="place-sub">{x.title}</p>
            <p>{x.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="reveal">
        <h2 set:html={c.villages.title} />
        <hr class="rule" />
        <div style="display:grid;gap:2rem">
          {c.villages.items.map((x) => (
            <article class="tile place">
              <h3>{x.name}</h3>
              <p class="place-sub">{x.title}</p>
              <p>{x.text}</p>
            </article>
          ))}
        </div>
      </div>
      <div class="media media-frame reveal" style="aspect-ratio:4/5">
        <Pic photo={PHOTOS.terraces} lang={lang} sizes="(min-width: 1280px) 580px, (min-width: 900px) 45vw, calc(100vw - 2.5rem)" />
      </div>
    </div>
  </section>

  <section class="cta-band dark section">
    <div class="container narrow center reveal">
      <h2 set:html={c.route.title} />
      <hr class="rule" />
      {c.route.text.map((p) => <p class="lead">{p}</p>)}
    </div>
  </section>
</Base>
