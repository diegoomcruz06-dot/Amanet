---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Pic from '../../components/Pic.astro';
import { langPaths, localePath, type Lang } from '../../i18n';
import { PHOTOS } from '../../i18n/images';
import { servicos } from '../../i18n/content/servicos';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const c = servicos[lang];
const photos = [PHOTOS.aerial, PHOTOS.valley, PHOTOS.terraces, PHOTOS.heart];
const links = [localePath(lang, 'experiencias', 'cruzeiros'), localePath(lang, 'experiencias', 'comboio'), localePath(lang, 'quintas'), ''];
---
<Base lang={lang} pageKey="servicos" title={c.title} description={c.description}>
  <PageHead lang={lang} eyebrow={c.eyebrow} title={c.h1} intro={c.intro} />

  <section class="container" style="padding-bottom:var(--section)">
    {c.blocks.map((b, i) => (
      <article class="exp">
        <div class:list={['media', { reveal: i > 0 }]}>
          <Pic photo={photos[i]} lang={lang} sizes="(min-width: 1280px) 580px, (min-width: 900px) 45vw, calc(100vw - 2.5rem)" />
        </div>
        <div class:list={[{ reveal: i > 0 }]}>
          <h2 style="font-size:clamp(1.9rem,3.4vw,2.75rem)">{b.title}</h2>
          <p>{b.text}</p>
          {b.button && <div class="btn-row"><a class="btn btn--outline" href={links[i]}>{b.button}</a></div>}
        </div>
      </article>
    ))}
  </section>

  <section class="section dark">
    <div class="container split">
      <div class="media reveal" style="aspect-ratio:4/5">
        <Pic photo={PHOTOS.terrace} lang={lang} sizes="(min-width: 1280px) 580px, (min-width: 900px) 45vw, calc(100vw - 2.5rem)" />
      </div>
      <div class="reveal">
        <h2>{c.stay.title}</h2>
        <hr class="rule" />
        <p>{c.stay.text}</p>
        <p class="lead">{c.stay.closing}</p>
        <div class="btn-row"><a class="btn btn--gold" href={localePath(lang, 'contacto')}>{c.stay.button}</a></div>
      </div>
    </div>
  </section>
</Base>
