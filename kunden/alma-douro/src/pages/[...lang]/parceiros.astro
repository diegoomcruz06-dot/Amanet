---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Pic from '../../components/Pic.astro';
import { langPaths, type Lang } from '../../i18n';
import { PHOTOS } from '../../i18n/images';
import { EMAIL } from '../../config';
import { parceiros } from '../../i18n/content/parceiros';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const c = parceiros[lang];
const j = c.join;
---
<Base lang={lang} pageKey="parceiros" title={c.title} description={c.description}>
  <PageHead lang={lang} eyebrow={c.eyebrow} title={c.h1} intro={c.intro} />

  <section class="section section--alt">
    <div class="container split">
      <div class="media media-frame reveal" style="aspect-ratio:4/5">
        <Pic photo={PHOTOS.terraces} lang={lang} sizes="(min-width: 1280px) 580px, (min-width: 900px) 45vw, calc(100vw - 2.5rem)" />
      </div>
      <div style="display:grid;gap:2.5rem">
        {c.blocks.map((b) => (
          <article class="tile reveal">
            <h2 style="font-size:clamp(1.7rem,2.8vw,2.2rem)">{b.title}</h2>
            <p>{b.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band dark section" id="tornar-se-parceiro">
    <div class="container narrow center reveal">
      <h2 set:html={j.title} />
      <hr class="rule" />
      {j.text.map((p) => <p class="lead">{p}</p>)}
      <div class="btn-row"><a class="btn btn--gold" href={`mailto:${EMAIL}?subject=${encodeURIComponent(j.mailSubject)}`}>{j.button}</a></div>
      <p style="margin-top:1.5rem"><a href={`mailto:${EMAIL}`} style="color:var(--gold-light)">{EMAIL}</a></p>
    </div>
  </section>
</Base>
