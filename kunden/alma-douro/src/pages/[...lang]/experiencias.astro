---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Pic from '../../components/Pic.astro';
import CtaBand from '../../components/CtaBand.astro';
import { langPaths, localePath, type Lang } from '../../i18n';
import { PHOTOS } from '../../i18n/images';
import { experiencias } from '../../i18n/content/experiencias';
import { home } from '../../i18n/content/home';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const c = experiencias[lang];
const photos = [PHOTOS.aerial, PHOTOS.terraces, PHOTOS.valley, PHOTOS.terrace];
---
<Base lang={lang} pageKey="experiencias" title={c.title} description={c.description}>
  <PageHead lang={lang} eyebrow={c.eyebrow} title={c.h1} intro={c.intro} />

  <section class="container" style="padding-bottom:var(--section)">
    {c.items.map((item, i) => (
      <article class="exp" id={item.id}>
        <div class:list={['media', { reveal: i > 0 }]}>
          <Pic photo={photos[i]} lang={lang} sizes="(min-width: 1280px) 580px, (min-width: 900px) 45vw, calc(100vw - 2.5rem)" priority={i === 0} />
        </div>
        <div class:list={[{ reveal: i > 0 }]}>
          <span class="num">0{i + 1}</span>
          <h2 style="font-size:clamp(1.9rem,3.4vw,2.75rem)">{item.title}</h2>
          {item.text.map((p) => <p>{p}</p>)}
          {'example' in item && item.example && (
            <div class="example">
              <span class="label">{c.example}</span>
              <span set:html={item.example} />
              <br /><a class="link-arrow" style="margin-top:.75rem" href={localePath(lang, 'parceiros')}>{c.partnerLink}</a>
            </div>
          )}
          <div class="btn-row"><a class="btn btn--gold" href={localePath(lang, 'contacto')}>{c.button}</a></div>
        </div>
      </article>
    ))}
  </section>

  <CtaBand lang={lang} title={home[lang].cta.title} paragraphs={home[lang].cta.paragraphs} button={home[lang].cta.button} />
</Base>
