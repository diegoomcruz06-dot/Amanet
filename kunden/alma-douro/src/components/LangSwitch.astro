---
import { LANGS, UI, HTML_LANG, localePath, type Lang, type PageKey } from '../i18n';
interface Props { lang: Lang; pageKey: PageKey }
const { lang, pageKey } = Astro.props;
---
<ul class="lang-switch" aria-label={UI[lang].langNav}>
  {LANGS.map((l) => (
    <li>
      <a href={localePath(l, pageKey === '404' ? '' : pageKey)} hreflang={HTML_LANG[l]} lang={HTML_LANG[l]} aria-current={l === lang ? 'true' : undefined}>
        <span aria-hidden="true">{l.toUpperCase()}</span><span class="visually-hidden">{UI[l].langName}</span>
      </a>
    </li>
  ))}
</ul>
