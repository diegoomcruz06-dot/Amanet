---
import { Image } from 'astro:assets';
import monogram from '../assets/logo/monograma-alma-douro.png';
import { NAV, UI, localePath, type Lang, type PageKey } from '../i18n';
import LangSwitch from './LangSwitch.astro';

interface Props { lang: Lang; pageKey: PageKey }
const { lang, pageKey } = Astro.props;
const t = UI[lang];
// Auf der Startseite liegt der Header transparent über dem Hero-Foto.
const overlay = pageKey === '';
---
<header class:list={['site-header', { 'site-header--overlay': overlay }]}>
  <div class="container header-inner">
    <a class="brand" href={localePath(lang, '')} aria-label={t.logoAlt}>
      <Image src={monogram} alt="" width={112} height={112} widths={[56, 112]} sizes="56px" loading="eager" />
      <span class="brand-name" aria-hidden="true">Alma Douro</span>
    </a>
    <nav class="site-nav" id="site-nav" aria-label={t.mainNav}>
      <ul class="nav-list">
        {NAV.map((n) => (
          <li><a href={localePath(lang, n.key)} aria-current={n.key === pageKey ? 'page' : n.key === 'experiencias' && pageKey === 'quintas' ? 'true' : undefined}>{n.label[lang]}</a></li>
        ))}
      </ul>
      <div class="nav-extra">
        <a class="btn btn--gold" href={localePath(lang, 'contacto')}>{t.cta}</a>
        <LangSwitch lang={lang} pageKey={pageKey} />
      </div>
    </nav>
    <div class="header-actions">
      <LangSwitch lang={lang} pageKey={pageKey} />
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-open={t.menu} data-close={t.closeMenu}>
        <span class="bars" aria-hidden="true"></span><span class="label">{t.menu}</span>
      </button>
    </div>
  </div>
</header>
