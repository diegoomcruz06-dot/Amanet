---
import '@fontsource-variable/cormorant-garamond/wght.css';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import '@fontsource-variable/jost/wght.css';
import '../styles/global.css';
import cormorantLatin from '@fontsource-variable/cormorant-garamond/files/cormorant-garamond-latin-wght-normal.woff2?url';
import cormorantItalicLatin from '@fontsource-variable/cormorant-garamond/files/cormorant-garamond-latin-wght-italic.woff2?url';
import jostLatin from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';
import logo from '../assets/logo/logo-alma-douro.png';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { LANGS, DEFAULT_LANG, HTML_LANG, OG_LOCALE, UI, localePath, navLabel, type Lang, type PageKey } from '../i18n';
import { SITE_URL, SITE_NAME, EMAIL, PHONE, SOCIAL, whatsappUrl } from '../config';

interface Props {
  lang: Lang;
  pageKey: PageKey;
  title: string;
  description: string;
  noindex?: boolean;
}
const { lang, pageKey, title, description, noindex = false } = Astro.props;
const t = UI[lang];
const abs = (p: string) => new URL(p, SITE_URL).href;
const canonical = abs(localePath(lang, pageKey));
const alternates = noindex ? [] : LANGS.map((l) => ({ hreflang: HTML_LANG[l], href: abs(localePath(l, pageKey)) }));
const ogImage = abs('/og-alma-douro.jpg');
const logoPng = await getImage({ src: logo, width: 512, format: 'png' });

const org = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  '@id': `${SITE_URL}/#organization`,
  name: SITE_NAME,
  url: `${SITE_URL}/`,
  logo: abs(logoPng.src),
  image: ogImage,
  email: EMAIL,
  telephone: PHONE.display.replace(/ /g, ''),
  sameAs: SOCIAL.map((s) => s.url),
  founder: { '@type': 'Person', name: 'Tânia Afonso' },
  availableLanguage: ['fr', 'pt', 'en'],
  areaServed: { '@type': 'Place', name: 'Douro, Portugal' },
  slogan: t.signature,
};
const breadcrumb =
  pageKey && pageKey !== '404'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: t.home, item: abs(localePath(lang, '')) },
          { '@type': 'ListItem', position: 2, name: navLabel(lang, pageKey) || title.split(' | ')[0], item: canonical },
        ],
      }
    : null;
const wa = whatsappUrl(t.whatsappText);
---
<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={abs(localePath(DEFAULT_LANG, pageKey))} />}

    {[cormorantLatin, cormorantItalicLatin, jostLatin].map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <script is:inline>document.documentElement.classList.add('js')</script>

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#17130F" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Alma Douro" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    {breadcrumb && <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <Header lang={lang} pageKey={pageKey} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} pageKey={pageKey} />
    <a class="wa-fab" href={wa ?? localePath(lang, 'contacto')} {...(wa ? { rel: 'noopener', target: '_blank' } : {})} aria-label={wa ? t.whatsapp : t.cta}>
      <WhatsAppIcon />
    </a>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
